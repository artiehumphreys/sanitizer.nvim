#!/usr/bin/env bash
# Format staged Lua with stylua before commit
set -euo pipefail

files=()
while IFS= read -r -d '' f; do
  files+=("$f")
done < <(git diff --cached --name-only -z --diff-filter=ACM -- '*.lua')
[ ${#files[@]} -eq 0 ] && exit 0

if ! command -v stylua >/dev/null 2>&1; then
  echo "pre-commit: stylua not found, skipping format" >&2
  exit 0
fi

stylua "${files[@]}"
git add -- "${files[@]}"
