{
  "runtime": {
    "version": "LuaJIT",
    "path": [
      "lua/?.lua",
      "lua/?/init.lua",
      "?.lua",
      "?/init.lua"
    ],
    "pathStrict": true
  },
  "workspace": {
    "checkThirdParty": false,
    "library": [
      "lua",
      "$VIMRUNTIME/lua",
      "${3rd}/luv/library"
    ]
  },
  "type": {
    "checkTableShape": true
  },
  "completion": {
    "callSnippet": "Replace"
  }
}